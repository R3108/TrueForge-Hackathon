+          type: EventType.USER_TOOL_APPROVAL,
+          thread_id: 'main',
+          tool_call_id: 'call-1',
+          approval: { status: 'allow' },
+        },
+      ]),
+    );
+    const resumeEvents = await drain(thread.execute());
+
+    expect(dispatched()).toBe(1);
+    const toolResponse = resumeEvents.find(e => e.type === EventType.TOOL_RESPONSE);
