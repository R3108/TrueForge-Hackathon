diff --git a/benchmark/deterministic_harness.mjs b/benchmark/deterministic_harness.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..00dda5d379500e1d7846f670bded743ba3ecebe0
--- /dev/null
+++ b/benchmark/deterministic_harness.mjs
@@ -0,0 +1,1207 @@
+/**
+ * Deterministic, no-network harness-quality evaluation for the adaptive kernel.
+ *
+ * This is not a prose report. It exercises the *real* built runtime classes and
+ * pure functions exported from the compiled core barrel
+ * (`packages/trueforge-core/dist/core/index.mjs`) against paired fixtures,
+ * measures them, and emits:
+ *
+ *   1. one machine-readable JSON object on a marked block, and
+ *   2. a compact human table.
+ *
+ * The classes under test are the genuine kernel coordinator surface:
+ *   - `ToolExecutionCoordinator` (prepare/execute/executeBatch/reconcile),
+ *   - `VerificationCoordinator` (typed evidence vs prose),
+ *   - `ProgressAndRecoveryController` (retry policy + persisted restart
+ *     classification from real lifecycle events),
+ *   - `NoProgressController` (adaptive stop loop),
+ *   - `ToolCapabilityRegistry` / `bindToolCapability`,
+ *   - `validateAgainstInputSchema`.
+ *
+ * Tool sets are plain-JS mock `IToolSet` objects — no MCP transport, no network,
+ * no LLM. Every mock records whether `callTool` was dispatched so "blocked
+ * before dispatch" and "no dispatch on denial" are asserted against the real
+ * coordinator, not a stub. Mock tool latency is deliberately excluded from the
+ * coordinator latency measurement: the coordinator distribution is measured only
+ * on the pure prepare + non-dispatching execute path (terminal invocations that
+ * never reach `callTool`), so no artificial tool sleep contaminates the p95.
+ *
+ * The harness imports the *built dist* (`.mjs`). The root
+ * `benchmark:deterministic` script builds core first, so the sources are proven
+ * to typecheck and compile before they are exercised here. No dependencies are
+ * required and nothing is generated by hand.
+ *
+ * External model benchmarking (end-to-end LLM repair quality) is out of scope
+ * for a deterministic offline harness and is reported as
+ * `unavailable_unverified` rather than fabricated.
+ */
+
+import { createRequire } from 'node:module';
+import os from 'node:os';
+import path from 'node:path';
+import { performance } from 'node:perf_hooks';
+import process from 'node:process';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+/* ------------------------------------------------------------------ *
+ * Resolve and import the built core barrel.                           *
+ * ------------------------------------------------------------------ */
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const CORE_DIST = path.resolve(HERE, '..', 'packages', 'trueforge-core', 'dist', 'core', 'index.mjs');
+
+const require = createRequire(import.meta.url);
+void require; // reserved for potential CJS fallback; the dist is ESM.
+
+let core;
+try {
+  core = await import(pathToFileURL(CORE_DIST).href);
+} catch (error) {
+  process.stderr.write(
+    `Failed to import built core from ${CORE_DIST}. ` +
+      `Run \`npm run benchmark:deterministic\` (which builds core first) or build ` +
+      `@truefoundry/trueforge-core before running this harness directly.\n` +
+      `${error instanceof Error ? (error.stack ?? error.message) : String(error)}\n`,
+  );
+  process.exitCode = 1;
+  throw error;
+}
+
+const {
+  ToolExecutionCoordinator,
+  VerificationCoordinator,
+  ProgressAndRecoveryController,
+  NoProgressController,
+  ToolCapabilityRegistry,
+  bindToolCapability,
+  validateAgainstInputSchema,
+  EventType,
+} = core;
+
+for (const [name, value] of Object.entries({
+  ToolExecutionCoordinator,
+  VerificationCoordinator,
+  ProgressAndRecoveryController,
+  NoProgressController,
+  ToolCapabilityRegistry,
+  bindToolCapability,
+  validateAgainstInputSchema,
+  EventType,
+})) {
+  if (value === undefined) {
+    throw new Error(`Built core barrel is missing required export: ${name}`);
+  }
+}
+
+/* ------------------------------------------------------------------ *
+ * Deterministic constants (no randomness in fixture inputs).          *
+ * ------------------------------------------------------------------ */
+
+const STABLE_TOOL_SET_ID = 'mock-github';
+const POLICY_VERSION = 'adaptive-kernel-harness-v1';
+
+function context(overrides = {}) {
+  return {
+    session_id: 'session-1',
+    turn_id: 'turn-1',
+    thread_id: 'main',
+    model_message_id: 'message-1',
+    root_tool_call_id: null,
+    parent_tool_call_id: null,
+    signal: undefined,
+    event_recorder: undefined,
+    ...overrides,
+  };
+}
+
+/* ------------------------------------------------------------------ *
+ * Capability builders — real `bindToolCapability` / registry values.  *
+ * ------------------------------------------------------------------ */
+
+function definition(input) {
+  return {
+    tool_name: input.tool_name,
+    side_effect_class: input.side_effect_class,
+    retry_capability: input.retry_capability,
+    concurrency: input.concurrency ?? { kind: 'exclusive' },
+    timeout_ms: input.timeout_ms ?? null,
+    output_schema: input.output_schema ?? null,
+    result_size_class: input.result_size_class ?? 'small',
+    evidence_capabilities: input.evidence_capabilities ?? [],
+    sensitive_argument_paths: input.sensitive_argument_paths ?? [],
+    tags: input.tags ?? [],
+  };
+}
+
+function capability(input) {
+  return bindToolCapability({
+    stable_tool_set_id: STABLE_TOOL_SET_ID,
+    definition: definition(input),
+  });
+}
+
+/* ------------------------------------------------------------------ *
+ * Plain-JS mock IToolSet. Records dispatches; no network, no MCP.     *
+ *                                                                     *
+ * `callTool` is driven by a per-tool behavior map:                    *
+ *   { kind: 'ok', text, structured } -> resolved success              *
+ *   { kind: 'error', text }          -> resolved isError result       *
+ *   { kind: 'throw', message }       -> dispatch throws (transport)   *
+ *   { kind: 'delay', ms, then }      -> awaits ms then applies `then`  *
+ * `prepareToolCall` (when provided) can force a required_action        *
+ * (approval) with no dispatch, exercising the denial-no-dispatch path. *
+ * ------------------------------------------------------------------ */
+
+function toolResult(text, isError, structured) {
+  const result = { content: [{ type: 'text', text }] };
+  if (isError) {
+    result.isError = true;
+  }
+  if (structured !== undefined) {
+    result.structuredContent = structured;
+  }
+  return { result, wasInitialized: undefined };
+}
+
+function makeMockToolSet(options) {
+  const capabilities = new Map();
+  const inputSchemas = new Map();
+  const behaviors = new Map();
+  for (const tool of options.tools) {
+    capabilities.set(tool.name, tool.capability);
+    if (tool.inputSchema !== undefined) {
+      inputSchemas.set(tool.name, tool.inputSchema);
+    }
+    behaviors.set(tool.name, tool.behavior ?? { kind: 'ok', text: `${tool.name}:ok` });
+  }
+
+  const state = {
+    dispatched: [],
+    activeConcurrent: 0,
+    maxConcurrent: 0,
+  };
+
+  async function applyBehavior(name, behavior) {
+    if (behavior.kind === 'throw') {
+      throw new Error(behavior.message ?? `mock ${name} dispatch failed`);
+    }
+    if (behavior.kind === 'delay') {
+      await new Promise(resolve => globalThis.setTimeout(resolve, behavior.ms));
+      return applyBehavior(name, behavior.then);
+    }
+    if (behavior.kind === 'error') {
+      return toolResult(behavior.text ?? `${name}:error`, true);
+    }
+    return toolResult(behavior.text ?? `${name}:ok`, false, behavior.structured);
+  }
+
+  const toolSet = {
+    name: options.name ?? STABLE_TOOL_SET_ID,
+    id: options.id ?? STABLE_TOOL_SET_ID,
+    preload: true,
+    hasPreloadedTools: true,
+    listTools() {
+      return Promise.resolve({ result: { tools: [] }, wasInitialized: undefined });
+    },
+    getToolCapability(toolName) {
+      return capabilities.get(toolName);
+    },
+    getToolInputSchema(toolName) {
+      return inputSchemas.get(toolName);
+    },
+    toolCallInfo(params) {
+      return Promise.resolve({
+        type: 'mcp',
+        mcp_server_id: toolSet.id,
+        mcp_server_name: toolSet.name,
+        original_tool_name: params.name,
+        is_approval_required: false,
+      });
+    },
+    async callTool(params) {
+      state.dispatched.push(params.name);
+      state.activeConcurrent += 1;
+      state.maxConcurrent = Math.max(state.maxConcurrent, state.activeConcurrent);
+      try {
+        return await applyBehavior(params.name, behaviors.get(params.name) ?? { kind: 'ok' });
+      } finally {
+        state.activeConcurrent -= 1;
+      }
+    },
+  };
+
+  if (options.requiredAction) {
+    // A preflight that resolves to a required action (approval) and never dispatches.
+    toolSet.prepareToolCall = () =>
+      Promise.resolve({
+        kind: 'required_action',
+        response: { approvalRequired: { tool_info: { type: 'mcp', original_tool_name: 'x' } } },
+      });
+  }
+
+  return { toolSet, state };
+}
+
+/* ------------------------------------------------------------------ *
+ * Response text extraction (isCallToolResponseResult is internal).    *
+ * ------------------------------------------------------------------ */
+
+function responseText(response) {
+  const content = response?.result?.content;
+  if (!Array.isArray(content)) {
+    return '';
+  }
+  const first = content[0];
+  return first && first.type === 'text' ? first.text : '';
+}
+
+function errorCodeOf(response) {
+  const text = responseText(response);
+  try {
+    const parsed = JSON.parse(text);
+    return typeof parsed?.error === 'string' ? parsed.error : null;
+  } catch {
+    return null;
+  }
+}
+
+/* ------------------------------------------------------------------ *
+ * A recording event recorder that captures real lifecycle events so   *
+ * ProgressAndRecoveryController.classifyPersisted runs on genuine      *
+ * coordinator output rather than hand-authored events.                *
+ * ------------------------------------------------------------------ */
+
+function recordingRecorder() {
+  const events = [];
+  return {
+    events,
+    recorder: event => {
+      events.push(event);
+      return Promise.resolve();
+    },
+  };
+}
+
+function invocation(input) {
+  return {
+    tool_call_id: input.tool_call_id,
+    tool_set: input.tool_set,
+    tool_name: input.tool_name,
+    arguments: input.arguments,
+    approval_decision: input.approval_decision,
+  };
+}
+
+/* ------------------------------------------------------------------ *
+ * Statistics helpers.                                                 *
+ * ------------------------------------------------------------------ */
+
+function percentile(sortedAsc, p) {
+  if (sortedAsc.length === 0) {
+    return Number.POSITIVE_INFINITY;
+  }
+  const index = Math.ceil(sortedAsc.length * p) - 1;
+  const clamped = Math.min(Math.max(index, 0), sortedAsc.length - 1);
+  return sortedAsc[clamped];
+}
+
+function round(value, digits = 4) {
+  if (!Number.isFinite(value)) {
+    return value;
+  }
+  const factor = 10 ** digits;
+  return Math.round(value * factor) / factor;
+}
+
+function distribution(samplesMs) {
+  const sorted = [...samplesMs].sort((a, b) => a - b);
+  const sum = sorted.reduce((acc, value) => acc + value, 0);
+  return {
+    samples: sorted.length,
+    min_ms: round(sorted[0] ?? 0),
+    p50_ms: round(percentile(sorted, 0.5)),
+    p95_ms: round(percentile(sorted, 0.95)),
+    p99_ms: round(percentile(sorted, 0.99)),
+    max_ms: round(sorted[sorted.length - 1] ?? 0),
+    mean_ms: round(sorted.length ? sum / sorted.length : 0),
+  };
+}
+
+/* ------------------------------------------------------------------ *
+ * Fixtures. Each async fn returns                                     *
+ *   { id, title, gate, pass, detail, measures }.                      *
+ * `gate: true` fixtures fail the whole run (non-zero) when !pass.      *
+ * ------------------------------------------------------------------ */
+
+const fixtures = [];
+const register = fn => fixtures.push(fn);
+
+/*
+ * Fixture 1 — direct baseline vs coordinator latency distributions.
+ *
+ * Baseline: `prepareBatch` for a single ready read invocation (canonical
+ * preparation — decode, fingerprint, capability resolution, input-schema check —
+ * the protocol work the coordinator always does). Coordinator: the same
+ * `prepareBatch` *plus* the full `execute` decision on a TERMINAL invocation
+ * (unknown tool) that provably never reaches `callTool`. This isolates the
+ * coordinator's own CPU (prepare + execute normalization + finalize) and
+ * excludes any mock tool latency, because no `callTool` is dispatched on the
+ * measured path. Warmup precedes the measured run.
+ */
+register(async function latencyDistributions() {
+  const WARMUP = 300;
+  const SAMPLES = 1500;
+
+  const readCap = capability({
+    tool_name: 'get_file_contents',
+    side_effect_class: 'read_only',
+    retry_capability: 'safe',
+    concurrency: { kind: 'parallel_safe' },
+  });
+  const { toolSet } = makeMockToolSet({
+    tools: [{ name: 'get_file_contents', capability: readCap }],
+  });
+  const coordinator = new ToolExecutionCoordinator();
+
+  const baselineSample = async i => {
+    const started = performance.now();
+    const batch = await coordinator.prepareBatch({
+      invocations: [
+        invocation({
+          tool_call_id: `b-${i}`,
+          tool_set: toolSet,
+          tool_name: 'get_file_contents',
+          arguments: { owner: 'o', repo: 'r', path: `p${i}` },
+        }),
+      ],
+      context: context(),
+    });
+    // Touch the prepared result so it cannot be optimized away.
+    void batch.invocations[0].kind.length;
+    return performance.now() - started;
+  };
+
+  const coordinatorSample = async i => {
+    const started = performance.now();
+    const batch = await coordinator.prepareBatch({
+      invocations: [
+        // No tool_set => terminal 'unknown_tool' prepared invocation; execute()
+        // returns a terminal outcome without ever calling any tool.
+        invocation({
+          tool_call_id: `c-${i}`,
+          tool_set: undefined,
+          tool_name: 'get_file_contents',
+          arguments: { owner: 'o', repo: 'r', path: `p${i}` },
+        }),
+      ],
+      context: context(),
+    });
+    const outcome = await coordinator.execute({ prepared: batch.invocations[0], signal: undefined });
+    void outcome.status.length;
+    return performance.now() - started;
+  };
+
+  for (let i = 0; i < WARMUP; i++) {
+    await baselineSample(i);
+    await coordinatorSample(i);
+  }
+
+  const baseline = [];
+  const coordinatorTimes = [];
+  for (let i = 0; i < SAMPLES; i++) {
+    baseline.push(await baselineSample(i));
+    coordinatorTimes.push(await coordinatorSample(i));
+  }
+
+  const baselineDist = distribution(baseline);
+  const coordinatorDist = distribution(coordinatorTimes);
+  const overheadP50 = round(coordinatorDist.p50_ms - baselineDist.p50_ms);
+  const overheadP95 = round(coordinatorDist.p95_ms - baselineDist.p95_ms);
+
+  // Gate: coordinator p95 (pure gate CPU, no tool latency) OR the overhead p95
+  // must stay under 100 ms. We gate on the absolute coordinator p95 as a hard
+  // SLO and additionally report the delta; either being < 100 ms satisfies the
+  // spec's "p95 coordinator or delta < 100ms".
+  const gatePass = coordinatorDist.p95_ms < 100 || overheadP95 < 100;
+
+  return {
+    id: 'latency_distributions',
+    title: 'direct baseline vs coordinator latency distributions (tool latency excluded)',
+    gate: true,
+    pass: gatePass,
+    detail: `coordinator p95 ${coordinatorDist.p95_ms} ms; overhead p95 ${overheadP95} ms (gate < 100 ms)`,
+    measures: {
+      warmup_iterations: WARMUP,
+      excludes_tool_latency: true,
+      baseline_distribution_ms: baselineDist,
+      coordinator_distribution_ms: coordinatorDist,
+      coordinator_overhead_ms: { p50: overheadP50, p95: overheadP95 },
+      p95_gate_ms: 100,
+      p95_gate_pass: gatePass,
+    },
+  };
+});
+
+/*
+ * Fixture 2 — malformed JSON / missing-required / schema-mismatch blocked
+ * before dispatch. Each invalid call becomes a TERMINAL prepared invocation
+ * (validation failure) and `callTool` is never dispatched.
+ */
+register(async function blockedBeforeDispatch() {
+  const writeCap = capability({
+    tool_name: 'create_or_update_file',
+    side_effect_class: 'remote_write',
+    retry_capability: 'reconcile_before_retry',
+  });
+  const inputSchema = {
+    type: 'object',
+    required: ['owner', 'repo', 'path', 'content'],
+    properties: {
+      owner: { type: 'string' },
+      repo: { type: 'string' },
+      path: { type: 'string' },
+      content: { type: 'string' },
+    },
+  };
+  const { toolSet, state } = makeMockToolSet({
+    tools: [{ name: 'create_or_update_file', capability: writeCap, inputSchema }],
+  });
+  const coordinator = new ToolExecutionCoordinator();
+
+  const batch = await coordinator.prepareBatch({
+    invocations: [
+      // 2a. Malformed JSON string arguments -> invalid_arguments (decode fails).
+      invocation({
+        tool_call_id: 'bad-json',
+        tool_set: toolSet,
+        tool_name: 'create_or_update_file',
+        arguments: '{ not: valid json',
+      }),
+      // 2b. Missing required field (no `path`/`content`) -> input_schema_validation_failed.
+      invocation({
+        tool_call_id: 'missing',
+        tool_set: toolSet,
+        tool_name: 'create_or_update_file',
+        arguments: { owner: 'o', repo: 'r' },
+      }),
+      // 2c. Schema type mismatch (content is a number) -> input_schema_validation_failed.
+      invocation({
+        tool_call_id: 'schema',
+        tool_set: toolSet,
+        tool_name: 'create_or_update_file',
+        arguments: { owner: 'o', repo: 'r', path: 'fixture/x.js', content: 123 },
+      }),
+    ],
+    context: context(),
+  });
+
+  const kinds = batch.invocations.map(item => item.kind);
+  const outcomes = await coordinator.executeBatch({ batch, signal: undefined });
+  const codes = outcomes.map(o => errorCodeOf(o.response));
+  const statuses = outcomes.map(o => o.status);
+
+  const pass =
+    kinds.every(k => k === 'terminal') &&
+    state.dispatched.length === 0 &&
+    codes[0] === 'invalid_arguments' &&
+    codes[1] === 'input_schema_validation_failed' &&
+    codes[2] === 'input_schema_validation_failed' &&
+    statuses.every(s => s === 'failed');
+
+  return {
+    id: 'blocked_before_dispatch',
+    title: 'malformed JSON / missing-required / schema-mismatch blocked before dispatch',
+    gate: true,
+    pass,
+    detail: `${kinds.filter(k => k === 'terminal').length}/3 terminal; dispatched=${state.dispatched.length}`,
+    measures: {
+      prepared_kinds: kinds,
+      dispatched_count: state.dispatched.length,
+      error_codes: codes,
+      statuses,
+    },
+  };
+});
+
+/*
+ * Fixture 3 — typed evidence vs fake prose, via the real VerificationCoordinator
+ * AND through the full coordinator finalize path.
+ *
+ * Typed: an output_schema + declared evidence capabilities + valid canonical
+ * structuredContent yields bounded typed EvidenceRecords with deterministic ids.
+ * Prose: a "successful" result carrying only prose text (no structuredContent)
+ * fails verification (missing_structured_content) and yields zero evidence, and
+ * the coordinator rewrites the outcome into a validation failure.
+ */
+register(async function typedEvidenceVsProse() {
+  const outputSchema = {
+    type: 'object',
+    required: ['status', 'exit_code'],
+    properties: {
+      status: { type: 'string', enum: ['passed', 'failed'] },
+      exit_code: { type: 'integer' },
+    },
+  };
+
+  // Direct VerificationCoordinator: typed vs prose, source present.
+  const verifier = new VerificationCoordinator();
+  const source = {
+    session_id: 'session-1',
+    turn_id: 'turn-1',
+    thread_id: 'main',
+    stable_tool_set_id: STABLE_TOOL_SET_ID,
+    tool_name: 'run_tests',
+    tool_call_id: 'evi-1',
+    root_tool_call_id: 'evi-1',
+    attempt_id: 'attempt-1',
+  };
+  const typed = verifier.verify({
+    output_schema: outputSchema,
+    evidence_capabilities: ['test_execution', 'test_execution', 'suite_summary'],
+    structured_content: { status: 'passed', exit_code: 0 },
+    source,
+  });
+  const prose = verifier.verify({
+    output_schema: outputSchema,
+    evidence_capabilities: ['test_execution'],
+    structured_content: undefined, // prose-only "success"
+    source,
+  });
+  // Determinism: same inputs reconstruct the same record id.
+  const typedAgain = verifier.verify({
+    output_schema: outputSchema,
+    evidence_capabilities: ['test_execution', 'suite_summary'],
+    structured_content: { status: 'passed', exit_code: 0 },
+    source,
+  });
+  const idsStable =
+    typed.kind === 'verified' &&
+    typedAgain.kind === 'verified' &&
+    typed.evidence.length === 2 &&
+    typed.evidence[0].id === typedAgain.evidence[0].id &&
+    typed.evidence.every(r => !('content' in r) && typeof r.result_digest === 'string');
+
+  // Full coordinator path: capability declares the output schema + evidence caps.
+  const evidenceCap = capability({
+    tool_name: 'run_tests',
+    side_effect_class: 'read_only',
+    retry_capability: 'safe',
+    concurrency: { kind: 'parallel_safe' },
+    output_schema: outputSchema,
+    evidence_capabilities: ['test_execution'],
+  });
+  const coordinator = new ToolExecutionCoordinator();
+
+  const { toolSet: typedToolSet } = makeMockToolSet({
+    tools: [
