+import {
+  isApprovalRequiredResponse,
+  isAuthRequired,
+  isCallToolResponseResult,
+  isClientSideToolRequiredResponse,
+  toolResultResponse,
+  type CallToolResponse,
+  type IToolSet,
+  type ToolApprovalTargetIdentity,
