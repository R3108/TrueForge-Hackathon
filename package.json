{
  "name": "licence-to-patch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An on-call agent with a licence to patch: reads a production error, reproduces it in a sandbox, writes a fix, and opens a pull request - pausing for human approval before it touches your repo.",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "provision": "node --env-file-if-exists=.env --experimental-strip-types src/cli/provision.ts",
    "dispatch": "node --env-file-if-exists=.env --experimental-strip-types src/cli/dispatch.ts",
    "doctor": "node --env-file-if-exists=.env --experimental-strip-types src/cli/doctor.ts",
    "demo:firewall": "node --experimental-strip-types src/cli/firewall-demo.ts",
    "bench": "npm run build && node --experimental-strip-types benchmark/deterministic_harness.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"packages/trueforge-core/tests/**/*.test.ts\" \"benchmark/**/*.test.mjs\"",
    "trueforge:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/trueforge-install.ps1",
    "trueforge:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/trueforge-dev.ps1",
    "trueforge:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/trueforge-check.ps1"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
