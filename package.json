{
  "name": "licence-to-patch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An on-call agent with a licence to patch: reads a production error, reproduces it in a sandbox, writes a fix, and opens a pull request - pausing for human approval before it touches your repo.",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "provision": "node --experimental-strip-types src/cli/provision.ts",
    "dispatch": "node --experimental-strip-types src/cli/dispatch.ts",
    "doctor": "node --experimental-strip-types src/cli/doctor.ts"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
