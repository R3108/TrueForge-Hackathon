# ── TrueForge server ────────────────────────────────────────────────────────
# Local mode:  npx @truefoundry/trueforge@latest   → http://localhost:8790
TRUEFORGE_BASE_URL=http://localhost:8790
# Only needed when the server has OIDC login enabled (hosted mode). Leave blank locally.
TRUEFORGE_TOKEN=

# ── Model ───────────────────────────────────────────────────────────────────
# Fully-qualified model name: provider/model, exactly as returned by
#   curl http://localhost:8790/api/v1/models
# Note the dashes: the FQN is `openai/gpt-5-6-terra`, not `openai/gpt-5.6-terra`.
# Configure the provider first in TrueForge → Settings → Models. The API key
# lives THERE, never in this repo.
LTP_MODEL=openai/gpt-5-6-terra

# ── Target repository the agent is allowed to patch ─────────────────────────
# A DIFFERENT repository from this one, deliberately. The agent's GitHub scope
# is repo-granular, so pointing it at a separate service is what makes "the
# agent cannot rewrite its own approval gate" a structural fact rather than a
# promise enforced by the glob matcher below. Pointing this at the harness
# itself is refused outright - see src/config.ts.
LTP_TARGET_REPO=R3108/cart-service
LTP_BASE_BRANCH=main

# ── Write perimeter ─────────────────────────────────────────────────────────
# Comma-separated globs. The agent may write ONLY to paths matching these.
# Anything outside is denied automatically, before a human is ever asked.
#
# These are paths INSIDE the target repository, not this one.
#
# The repository boundary already keeps the agent away from its own harness.
# This is the second layer: inside the service it may repair, it owns the source
# but not the CI that verifies its patch, and not the dependency manifest.
#
# A `!` prefix excludes, and exclusions win over grants. Check any path with
#   npm run perimeter -- src/cart.js
# Leave blank to disable (only the human gate then applies).
LTP_WRITE_PATHS=src/**,!.github/**,!package.json,!package-lock.json

# ── Credential tripwire ─────────────────────────────────────────────────────
# What to do when a payload bound for the repository contains something shaped
# like a credential (a token, a private key, a hardcoded secret).
#   block  refuse it automatically, without asking a human   [default]
#   warn   show it in red on the approval prompt and let a human decide
#   off    do not scan
LTP_SECRET_POLICY=block

# ── Decision journal ────────────────────────────────────────────────────────
# Where the tamper-evident record of each run is written. Git-ignored: an audit
# trail belongs to the machine that made the decisions, not to the repository.
# Verify one with: npm run journal -- runs/<session-id>.jsonl
LTP_JOURNAL_DIR=runs

# ── Connector names as registered in TrueForge → Settings → Connectors ──────
# Credentials live in the connector, never in the agent spec or this repo.
LTP_CONNECTOR_SENTRY=sentry
LTP_CONNECTOR_GITHUB=github
