# Sentry DSN for this project. Create a free project at https://sentry.io,
# choose the Node.js platform, and paste the DSN here.
# Without it the service runs fine but reports nothing.
SENTRY_DSN=

# Tags every event with a release, so a Sentry issue can say which deploy
# introduced the error.
SENTRY_RELEASE=cart-service@1.0.0

NODE_ENV=production
PORT=3000
